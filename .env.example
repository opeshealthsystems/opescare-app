# Copy to `.env` (gitignored) and fill in. Every value here is read by
# app.config.js / the Expo CLI on THIS machine only; an EAS build worker gets
# its values from EAS environment variables instead (docs/push-delivery-runbook.md).
#
# EXPO_PUBLIC_* values are inlined into the JavaScript bundle at build time and
# are therefore visible to anyone with the app — never put a secret in one.

# Base URL of the OpesCare Finder backend API the app talks to.
# Overrides the built-in default (https://finder.opescare.cloud/api); include the /api suffix.
EXPO_PUBLIC_API_BASE_URL=https://finder.opescare.cloud/api

# ── Push delivery ────────────────────────────────────────────────────────────

# The EAS project id: the UUID printed by `eas init` (runbook step 2). Not a
# secret, but it is the OWNER's project — a fork must never reuse the source
# app's id, which is why app.json carries none. Leave unset until you have
# run `eas init`; the app then reports push as "not available in this build"
# rather than pretending. A malformed value or the nil UUID makes the config
# refuse to build.
EAS_PROJECT_ID=

# Path to google-services.json from the Firebase console (runbook step 3),
# needed for the Android FCM half of an Expo push token. Keep the file OUTSIDE
# the repo or at ./google-services.json (gitignored). If set, the file must
# exist or the config refuses to build. On EAS this is a FILE environment
# variable; EAS writes the file and fills in the path itself.
GOOGLE_SERVICES_JSON=

# Set to 1 only for a build that is deliberately made WITHOUT push (no
# google-services.json). Otherwise an EAS Android build without
# GOOGLE_SERVICES_JSON is refused, because the APK could never receive a push.
# OPESCARE_BUILD_WITHOUT_PUSH=1

# ── Build-time switches (all default OFF) ────────────────────────────────────

# Show the one-tap demo sign-in menu (seeded demo patients). eas.json pins this
# to 1 for development/preview builds and to 0 for production, and the pin wins.
# EXPO_PUBLIC_DEMO_LOGINS=1

# Force the clinician preview persona. Pinned to 0 in preview/production builds.
# EXPO_PUBLIC_DOCTOR_PERSONA=1

# Ship expo-router's /_sitemap developer route. Never on for a deployed build.
# EXPO_PUBLIC_ENABLE_SITEMAP=1
