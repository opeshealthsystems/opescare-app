# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files — EAS_PROJECT_ID and GOOGLE_SERVICES_JSON live in .env, and
# Expo inlines every EXPO_PUBLIC_* value it finds there at bundle time, so a
# committed .env would ship one developer's flags to everyone. Only the
# documented template is tracked.
.env
.env.*
!.env.example

# push credentials — never committed; see docs/push-delivery-runbook.md
google-services.json
GoogleService-Info.plist
*-firebase-adminsdk-*.json
*service-account*.json
AuthKey_*.p8

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Expo web export — the built copy is deployed from apps/api-laravel/public/app
dist-web/

# Design exports dropped into the working tree are reference material, not app code.
/Health ID retuned/
