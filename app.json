{
  "expo": {
    "name": "OpesCare",
    "slug": "opescare-finder",
    "scheme": "opescarefinder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FDF8F0",
    "primaryColor": "#0F4C81",
    "description": "Find medicines and blood in stock near you, book appointments at verified facilities, and carry your OpesCare Health ID and medical records wherever you get care.",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cloud.opescare.finder",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "en",
          "fr"
        ],
        "CFBundleAllowMixedLocalizations": true,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "cloud.opescare.finder",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-localization",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#FDF8F0"
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "OpesCare uses your photo library so you can put your own photo on your Health ID card.",
          "cameraPermission": "OpesCare uses the camera so you can take the photo for your Health ID card.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "OpesCare uses your location to find nearby pharmacies and healthcare facilities on the Care Map."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0F4C81",
          "sounds": [
            "./assets/sounds/opescare_consent.wav",
            "./assets/sounds/opescare_message.wav",
            "./assets/sounds/opescare_result.wav",
            "./assets/sounds/opescare_appointment.wav",
            "./assets/sounds/opescare_alert.wav"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "OpesCare uses the camera so a clinician can scan a patient's Health ID code.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "//": "This fork's OWN EAS project (opesware/opescare-finder), created 2026-09-06. It is deliberately not the source app's project — a fork must never push builds or updates to it. EAS cannot write this value itself because app.config.js is a dynamic config, so it is maintained here by hand; app.config.js reads EAS_PROJECT_ID first and falls back to this.",
        "projectId": "d45f34e5-c4d7-4612-960f-844584a7054d"
      }
    },
    "owner": "opesware",
    "experiments": {
      "baseUrl": "/finder"
    }
  }
}
