{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://opescare.com/api"
      },
      "channel": "development"
    },
    "local-api": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://192.168.1.33/api",
        "OPESCARE_BUILD_WITHOUT_PUSH": "1"
      }
    },
    "preview": {
      "autoIncrement": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://opescare.com/api",
        "EXPO_PUBLIC_DOCTOR_PERSONA": "0"
      },
      "channel": "preview"
    },
    "demo": {
      "autoIncrement": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://opescare.com/api",
        "EXPO_PUBLIC_DOCTOR_PERSONA": "0",
        "OPESCARE_BUILD_WITHOUT_PUSH": "1"
      },
      "channel": "demo"
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_DOCTOR_PERSONA": "0",
        "EXPO_PUBLIC_API_BASE_URL": "https://opescare.com/api",
        "OPESCARE_BUILD_WITHOUT_PUSH": "1"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
